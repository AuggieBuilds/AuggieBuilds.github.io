---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectAtlas from '../../components/ProjectAtlas.astro';
import projects from '../../data/projects';
---

<BaseLayout title="Projects" description="Career highlights in structural engineering, construction, and residential renovation by Austin Woyshnar.">
  <section class="page-intro compact projects-intro">
    <span class="eyebrow">Projects</span>
    <h1>Projects that shaped my work.</h1>
    <div class="projects-intro-actions">
      <a class="button" href="#career-highlights">View career highlights <span aria-hidden="true">↓</span></a>
      <span>{projects.length} projects · Pennsylvania, Massachusetts, Maine, and Virginia</span>
    </div>
    <p>My experience spans structural engineering, contractor-side preconstruction and on-site coordination, and a personal residential renovation. At Thornton Tomasetti, I work on temporary conditions that make construction possible, from shoring and demolition sequencing to equipment loading and erection stability. The selected projects below reflect that range of work.</p>
  </section>

  <ProjectAtlas />

  <!-- ============ SECTION 1: SELECTED WORK ============ -->
  <section class="project-grid project-independent" aria-labelledby="independent-projects-heading">
    <div class="log-section-head">
      <span class="eyebrow">Selected Work</span>
      <h2 id="independent-projects-heading">Independent research and writing.</h2>
    </div>
    <article class="project-card project-featured">
      <a class="project-visual" href="/writing/the-watershed/"><img src="/writing/the-watershed/assets/scranton-coal-breaker.jpg" alt="Historic coal breaker in Scranton, Pennsylvania" /></a>
      <div><span class="eyebrow">Visual essay · 2026</span><h2><a href="/writing/the-watershed/">The Watershed</a></h2><p>I researched, wrote, and built this interactive essay to examine how cities turn temporary capital inflows into lasting local capacity.</p><ul class="topic-list"><li>Writing</li><li>Data</li><li>Interaction</li></ul><a class="text-link" href="/writing/the-watershed/">Open project ↗</a></div>
    </article>
  </section>

  <!-- ============ SECTION 2: ENGINEERING CASE STUDIES ============
       To add a new entry: copy one <article class="log-entry"> block below,
       paste it at the TOP of the list, and edit the date, title, tags, and text. -->
  <section class="project-grid">
    <div class="log-section-head">
      <span class="eyebrow">Engineering Case Studies</span>
      <p class="log-section-note">Selected technical problems from my construction engineering work, with client details kept general.</p>
    </div>

    <article class="log-entry">
      <span class="eyebrow">Logged · July 2026</span>
      <h3>Data Center Grating — Equipment Load Analysis</h3>
      <p>Analyzed bar grating for scissor- and boom-lift loads during a data center fit-out. Compared wheel and point loads with manufacturer capacity tables, then defined allowable equipment travel paths where uniform-load ratings did not capture the controlling condition.</p>
      <ul class="topic-list"><li>Equipment Loads</li><li>Temporary Works</li></ul>
    </article>

  </section>

  <!-- ============ SECTION 3: TOOLS ============
       Display-only showcase cards. No logins, no live tool access. -->
  <section class="project-grid">
    <div class="log-section-head">
      <span class="eyebrow">Tools</span>
      <p class="log-section-note">Models and tools I use to work through investment and engineering questions.</p>
    </div>

    <article class="project-card tool-card">
      <div class="project-visual tool-visual"><img src="/projects/tool-placeholder.svg" alt="Placeholder — screenshot coming soon" /></div>
      <div>
        <span class="eyebrow">Personal tool · In use</span>
        <h3>Real Estate Analysis Tools</h3>
        <p>I built these models to compare purchase, renovation, rental, and refinance assumptions for small residential and commercial properties.</p>
        <ul class="topic-list"><li>Real Estate</li><li>Analysis</li></ul>
      </div>
    </article>
  </section>
</BaseLayout>
