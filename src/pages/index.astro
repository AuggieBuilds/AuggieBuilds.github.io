---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout>
  <section class="home-hero">
    <div class="hero-copy">
      <span class="eyebrow">Essays & independent projects</span>
      <h1>I write about how places build, lose, and renew capacity.</h1>
      <p>Long-form work on cities, infrastructure, institutions, capital flows, and the systems that shape everyday opportunity.</p>
      <div class="hero-actions"><a class="button" href="/writing/">Read the writing</a><a class="text-link" href="/about/">About this work <span aria-hidden="true">→</span></a></div>
    </div>
    <aside class="hero-index" aria-label="Primary themes">
      <span>Current themes</span>
      <ol><li><b>01</b>Cities and regional economies</li><li><b>02</b>Infrastructure and public systems</li><li><b>03</b>Institutions and industrial succession</li></ol>
    </aside>
  </section>

  <section class="section-block featured-block">
    <header class="section-heading"><div><span class="eyebrow">Featured work</span><h2>Start here</h2></div><a class="text-link" href="/writing/">All writing <span aria-hidden="true">→</span></a></header>
    <ArticleCard
      href="/writing/the-watershed/"
      title="The Watershed"
      description="A visual essay about how cities convert temporary capital flows into durable institutions, local capability, and successor industries."
      eyebrow="Interactive visual essay · 2026"
      topics={['Regional economics', 'Infrastructure', 'Institutions']}
      image="/writing/the-watershed/assets/scranton-coal-breaker.jpg"
      featured
    />
  </section>

  <section class="section-block principles-block">
    <header class="section-heading"><div><span class="eyebrow">A working method</span><h2>Research that can be seen and used.</h2></div></header>
    <div class="principles-grid">
      <article><span>01</span><h3>Follow the system</h3><p>Trace how money, authority, skills, and incentives move through a place rather than stopping at a headline number.</p></article>
      <article><span>02</span><h3>Make the model visible</h3><p>Use diagrams and interactive explanations to turn abstract institutional relationships into something readers can inspect.</p></article>
      <article><span>03</span><h3>Stay close to place</h3><p>Connect large systems to the cities, firms, workers, and institutions that experience their consequences.</p></article>
    </div>
  </section>

</BaseLayout>
