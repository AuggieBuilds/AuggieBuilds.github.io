---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Austin Woyshnar home">
    <span class="wordmark-mark" aria-hidden="true">AW</span>
    <span>Austin Woyshnar</span>
  </a>
  <nav aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
