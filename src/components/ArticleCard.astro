---
interface Props {
  href: string;
  title: string;
  description: string;
  eyebrow: string;
  topics?: string[];
  image?: string;
  featured?: boolean;
}

const { href, title, description, eyebrow, topics = [], image, featured = false } = Astro.props;
---

<article class:list={['article-card', { featured, 'has-image': image }]}>
  {image && <a class="article-card-image" href={href} aria-label={`Read ${title}`}><img src={image} alt="" loading="lazy" /></a>}
  <div class="article-card-body">
    <span class="eyebrow">{eyebrow}</span>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    {topics.length > 0 && <ul class="topic-list" aria-label="Topics">{topics.map((topic) => <li>{topic}</li>)}</ul>}
    <a class="text-link" href={href}>Read the piece <span aria-hidden="true">↗</span></a>
  </div>
</article>
